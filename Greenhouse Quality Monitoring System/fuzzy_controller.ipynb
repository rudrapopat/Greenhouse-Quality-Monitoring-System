"""
fuzzy_controller.py
--------------------
Mamdani-type fuzzy inference engine for the Greenhouse Quality
Monitoring System, implementing EXACTLY the method described in the
report (Section 5):

    1. Fuzzify each crisp input (Temperature, Humidity, Soil Moisture)
    2. For each of the 15 rules, compute firing strength using MIN:
           w = MIN(mu_temperature, mu_humidity, mu_soil)
    3. Only rules with w > 0 are "fired".
    4. Defuzzify using the WEIGHTED AVERAGE method:
           GQI = sum(w_i * V_i) / sum(w_i)
       where V_i is the representative crisp value of the rule's
       output label (Poor=20, Fair=50, Excellent=80).
"""

from membership_functions import (
    fuzzify_temperature,
    fuzzify_humidity,
    fuzzify_soil_moisture,
    GQI_REPRESENTATIVE_VALUES,
)
from rules import RULES


def evaluate_rules(temp_mf, hum_mf, soil_mf):
    """
    Evaluate all 15 rules given the fuzzified membership dictionaries.

    Returns a list of dicts, one per FIRED rule (w > 0), each containing:
        rule_id, temp_label, hum_label, soil_label, output_label,
        mu_temp, mu_hum, mu_soil, firing_strength
    """
    fired = []
    for rule_id, t_label, h_label, s_label, out_label in RULES:
        mu_t = temp_mf[t_label]
        mu_h = hum_mf[h_label]
        mu_s = soil_mf[s_label]
        w = min(mu_t, mu_h, mu_s)  # MIN operator for AND
        if w > 0:
            fired.append({
                "rule_id": rule_id,
                "temp_label": t_label,
                "hum_label": h_label,
                "soil_label": s_label,
                "output_label": out_label,
                "mu_temp": mu_t,
                "mu_hum": mu_h,
                "mu_soil": mu_s,
                "firing_strength": w,
            })
    return fired


def defuzzify_weighted_average(fired_rules):
    """
    Weighted-average defuzzification:
        GQI = sum(w_i * V_i) / sum(w_i)

    If no rule fires (all inputs out of range), returns None.
    """
    numerator = 0.0
    denominator = 0.0
    for r in fired_rules:
        v_i = GQI_REPRESENTATIVE_VALUES[r["output_label"]]
        numerator += r["firing_strength"] * v_i
        denominator += r["firing_strength"]

    if denominator == 0:
        return None
    return numerator / denominator


def get_gqi_status(gqi):
    """
    Interpret the crisp GQI value into a status label.

    The report's status bands overlap (0-40 Poor, 30-70 Fair, 60-100
    Excellent). We resolve the overlap by picking the status whose
    membership function (from GQI_MFS) is highest at that GQI value -
    i.e. we reuse the fuzzy output MFs themselves to decide which
    linguistic label best describes the crisp result. This keeps the
    status consistent with the same fuzzy definitions used elsewhere,
    rather than introducing new arbitrary crisp cutoffs.
    """
    from membership_functions import GQI_MFS, triangular_mf

    memberships = {
        label: triangular_mf(gqi, *params) for label, params in GQI_MFS.items()
    }
    # Pick the label with the highest membership; ties broken by
    # preferring the "worse" outcome for safety-conscious behavior
    # (Poor > Fair > Excellent) - but ties are extremely rare with
    # these parameters.
    best_label = max(memberships, key=lambda lbl: memberships[lbl])
    return best_label


def compute_gqi(temperature, humidity, soil_moisture):
    """
    Full pipeline: fuzzify -> evaluate rules -> defuzzify -> status.

    Returns a dict with all intermediate results, useful for both the
    CLI/GUI display and for debugging/testing.
    """
    temp_mf = fuzzify_temperature(temperature)
    hum_mf = fuzzify_humidity(humidity)
    soil_mf = fuzzify_soil_moisture(soil_moisture)

    fired_rules = evaluate_rules(temp_mf, hum_mf, soil_mf)
    gqi = defuzzify_weighted_average(fired_rules)

    status = get_gqi_status(gqi) if gqi is not None else "Undefined (no rule fired)"

    return {
        "inputs": {
            "temperature": temperature,
            "humidity": humidity,
            "soil_moisture": soil_moisture,
        },
        "temp_mf": temp_mf,
        "hum_mf": hum_mf,
        "soil_mf": soil_mf,
        "fired_rules": fired_rules,
        "gqi": gqi,
        "status": status,
    }


if _name_ == "_main_":
    # Quick sanity check using the report's worked example:
    # Temperature = 32, Humidity = 45, Soil Moisture = 35 -> GQI = 50
    result = compute_gqi(32, 45, 35)
    print("Temperature MFs:", result["temp_mf"])
    print("Humidity MFs:", result["hum_mf"])
    print("Soil Moisture MFs:", result["soil_mf"])
    print("Fired rules:")
    for r in result["fired_rules"]:
        print(f"  {r['rule_id']}: w={r['firing_strength']:.3f} -> {r['output_label']}")
    print("GQI:", result["gqi"])
    print("Status:", result["status"])