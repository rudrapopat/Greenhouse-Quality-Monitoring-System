"""
gui.py
------
Simple Tkinter GUI/dashboard for the Greenhouse Quality Monitoring
System - suitable for a college project demonstration.

Features:
  - Large input fields for Temperature, Humidity, Soil Moisture
  - Large "Calculate GQI" button
  - Large output/result text
  - Displays Temperature, Humidity, Soil Moisture, GQI, Status
  - Displays fired rules and actuator response
  - Shows membership-function graphs in a separate tab

Run:
    python gui.py
"""

import tkinter as tk
from tkinter import ttk, messagebox

import matplotlib
matplotlib.use("TkAgg")

import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

from fuzzy_controller import compute_gqi
from actuator_control import decide_actuators

from membership_functions import (
    TEMPERATURE_MFS,
    HUMIDITY_MFS,
    SOIL_MOISTURE_MFS,
    GQI_MFS,
    TEMPERATURE_RANGE,
    HUMIDITY_RANGE,
    SOIL_MOISTURE_RANGE,
    GQI_RANGE,
    triangular_mf,
)

import numpy as np


class GreenhouseApp(tk.Tk):

    def _init_(self):
        super()._init_()

        # Window settings
        self.title("Greenhouse Quality Monitoring System (Fuzzy Logic)")
        self.geometry("1100x750")
        self.minsize(950, 650)

        # ---------------- FONT SETTINGS ----------------
        self.label_font = ("Arial", 19, "bold")
        self.input_font = ("Arial", 20)
        self.button_font = ("Arial", 19, "bold")
        self.output_font = ("Consolas", 18)
        self.heading_font = ("Arial", 21, "bold")

        # Notebook
        notebook = ttk.Notebook(self)
        notebook.pack(fill="both", expand=True)

        self.calc_tab = ttk.Frame(notebook)
        self.graph_tab = ttk.Frame(notebook)

        notebook.add(self.calc_tab, text="Calculator")
        notebook.add(self.graph_tab, text="Membership Graphs")

        self._build_calc_tab()
        self._build_graph_tab()

    # ==================================================
    # CALCULATOR TAB
    # ==================================================

    def _build_calc_tab(self):

        frame = ttk.Frame(self.calc_tab, padding=40)
        frame.pack(fill="x")

        # ---------------- TEMPERATURE ----------------

        ttk.Label(
            frame,
            text="Temperature (0-50 °C):",
            font=self.label_font
        ).grid(
            row=0,
            column=0,
            sticky="w",
            pady=10,
            padx=10
        )

        self.temp_var = tk.StringVar(value="32")

        temp_entry = tk.Entry(
            frame,
            textvariable=self.temp_var,
            width=15,
            font=self.input_font,
            justify="center"
        )

        temp_entry.grid(
            row=0,
            column=1,
            pady=10,
            padx=10,
            ipady=5
        )

        # ---------------- HUMIDITY ----------------

        ttk.Label(
            frame,
            text="Humidity (0-100 %RH):",
            font=self.label_font
        ).grid(
            row=1,
            column=0,
            sticky="w",
            pady=10,
            padx=10
        )

        self.hum_var = tk.StringVar(value="45")

        hum_entry = tk.Entry(
            frame,
            textvariable=self.hum_var,
            width=15,
            font=self.input_font,
            justify="center"
        )

        hum_entry.grid(
            row=1,
            column=1,
            pady=10,
            padx=10,
            ipady=5
        )

        # ---------------- SOIL MOISTURE ----------------

        ttk.Label(
            frame,
            text="Soil Moisture (0-100 %):",
            font=self.label_font
        ).grid(
            row=2,
            column=0,
            sticky="w",
            pady=10,
            padx=10
        )

        self.soil_var = tk.StringVar(value="35")

        soil_entry = tk.Entry(
            frame,
            textvariable=self.soil_var,
            width=15,
            font=self.input_font,
            justify="center"
        )

        soil_entry.grid(
            row=2,
            column=1,
            pady=10,
            padx=10,
            ipady=5
        )

        # ---------------- CALCULATE BUTTON ----------------

        calculate_button = tk.Button(
            frame,
            text="Calculate GQI",
            command=self.calculate,
            font=self.button_font,
            padx=25,
            pady=10
        )

        calculate_button.grid(
            row=3,
            column=0,
            columnspan=2,
            pady=20
        )

        # ==================================================
        # RESULTS
        # ==================================================

        result_frame = ttk.LabelFrame(
            self.calc_tab,
            text="Results",
            padding=15
        )

        result_frame.pack(
            fill="both",
            expand=True,
            padx=25,
            pady=15
        )

        # Result heading
        result_heading = tk.Label(
            result_frame,
            text="Fuzzy Controller Output",
            font=self.heading_font
        )

        result_heading.pack(
            anchor="w",
            pady=(0, 10)
        )

        # Output text box
        self.result_text = tk.Text(
            result_frame,
            height=25,
            wrap="word",
            font=self.output_font,
            padx=15,
            pady=15
        )

        self.result_text.pack(
            fill="both",
            expand=True
        )

        # Scrollbar
        scrollbar = ttk.Scrollbar(
            result_frame,
            orient="vertical",
            command=self.result_text.yview
        )

        scrollbar.pack(
            side="right",
            fill="y"
        )

        self.result_text.configure(
            yscrollcommand=scrollbar.set
        )

    # ==================================================
    # CALCULATE
    # ==================================================

    def calculate(self):

        try:
            t = float(self.temp_var.get())
            h = float(self.hum_var.get())
            s = float(self.soil_var.get())

        except ValueError:

            messagebox.showerror(
                "Invalid input",
                "Please enter numeric values."
            )

            return

        # Calculate GQI
        result = compute_gqi(t, h, s)

        gqi = result["gqi"]
        status = result["status"]

        # Actuator decision
        actuators = decide_actuators(gqi, s)

        lines = []

        lines.append(
            f"Temperature = {t} °C"
        )

        lines.append(
            f"Humidity    = {h} %RH"
        )

        lines.append(
            f"Soil Moisture = {s} %\n"
        )

        # ---------------- MEMBERSHIP VALUES ----------------

        lines.append("MEMBERSHIP VALUES")
        lines.append("-" * 70)

        lines.append(
            f"Temperature : {self._fmt(result['temp_mf'])}"
        )

        lines.append(
            f"Humidity    : {self._fmt(result['hum_mf'])}"
        )

        lines.append(
            f"Soil Moist. : {self._fmt(result['soil_mf'])}\n"
        )

        # ---------------- FIRED RULES ----------------

        lines.append("FIRED RULES")
        lines.append("-" * 70)

        if result["fired_rules"]:

            for r in result["fired_rules"]:

                lines.append(
                    f"{r['rule_id']}: "
                    f"Temp={r['temp_label']}, "
                    f"Hum={r['hum_label']}, "
                    f"Soil={r['soil_label']} "
                    f"-> {r['output_label']} "
                    f"(w = {r['firing_strength']:.3f})"
                )

        else:

            lines.append(
                "No rules fired."
            )

        lines.append("")

        # ---------------- FINAL GQI ----------------

        lines.append("FINAL RESULT")
        lines.append("-" * 70)

        if gqi is not None:

            lines.append(
                f"Final GQI = {gqi:.2f} %"
            )

        else:

            lines.append(
                "GQI undefined"
            )

        lines.append(
            f"Status    = {status}\n"
        )

        # ---------------- ACTUATORS ----------------

        lines.append("ACTUATOR RESPONSE")
        lines.append("-" * 70)

        lines.append(
            f"Fan   : {actuators['fan']}"
        )

        lines.append(
            f"Pump  : {actuators['pump']}"
        )

        lines.append(
            f"Alarm : {actuators['alarm']}"
        )

        # Display output
        self.result_text.delete(
            "1.0",
            tk.END
        )

        self.result_text.insert(
            tk.END,
            "\n".join(lines)
        )

    # ==================================================
    # FORMAT MEMBERSHIP VALUES
    # ==================================================

    @staticmethod
    def _fmt(d):

        return ", ".join(
            f"{k}={v:.3f}"
            for k, v in d.items()
        )

    # ==================================================
    # MEMBERSHIP GRAPH TAB
    # ==================================================

    def _build_graph_tab(self):

        fig, axes = plt.subplots(
            2,
            2,
            figsize=(10, 7)
        )

        specs = [

            (
                axes[0, 0],
                TEMPERATURE_MFS,
                TEMPERATURE_RANGE,
                "Temperature (°C)"
            ),

            (
                axes[0, 1],
                HUMIDITY_MFS,
                HUMIDITY_RANGE,
                "Humidity (%RH)"
            ),

            (
                axes[1, 0],
                SOIL_MOISTURE_MFS,
                SOIL_MOISTURE_RANGE,
                "Soil Moisture (%)"
            ),

            (
                axes[1, 1],
                GQI_MFS,
                GQI_RANGE,
                "GQI (%)"
            ),
        ]

        for ax, mf_dict, rng, xlabel in specs:

            x = np.linspace(
                rng[0],
                rng[1],
                300
            )

            for label, (a, b, c) in mf_dict.items():

                y = [
                    triangular_mf(
                        xi,
                        a,
                        b,
                        c
                    )
                    for xi in x
                ]

                ax.plot(
                    x,
                    y,
                    label=label,
                    linewidth=2
                )

            ax.set_xlabel(
                xlabel,
                fontsize=11
            )

            ax.set_ylabel(
                "Membership",
                fontsize=11
            )

            ax.legend(
                fontsize=9
            )

            ax.grid(
                alpha=0.3
            )

            ax.tick_params(
                labelsize=9
            )

        fig.tight_layout()

        canvas = FigureCanvasTkAgg(
            fig,
            master=self.graph_tab
        )

        canvas.draw()

        canvas.get_tk_widget().pack(
            fill="both",
            expand=True
        )


# ==================================================
# MAIN PROGRAM
# ==================================================

if _name_ == "_main_":

    app = GreenhouseApp()

    app.mainloop()