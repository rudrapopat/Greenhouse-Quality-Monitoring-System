"""
actuator_control.py
--------------------
Actuator decision layer (Section 9 of the report).

IMPORTANT: This layer runs strictly AFTER the fuzzy controller has
produced a crisp GQI value. It does NOT change or feed back into the
fuzzy inference itself - it is a simple rule-based post-processing
step that decides fan / pump / alarm behavior based on the final GQI
(and, for irrigation, the soil moisture reading).
"""


def decide_actuators(gqi, soil_moisture=None):
    """
    Decide actuator states from the crisp GQI (0-100) and, optionally,
    the raw soil moisture reading (used only to decide whether a short
    irrigation pulse is needed in the 40-70 band).

    Returns a dict: {"fan": ..., "pump": ..., "alarm": ...}
    """
    if gqi is None:
        return {"fan": "UNKNOWN", "pump": "UNKNOWN", "alarm": "ON (sensor/fuzzy fault)"}

    if gqi < 40:
        fan = "HIGH"
        pump = "ON (irrigation required)"
        alarm = "ON"
    elif gqi <= 70:
        fan = "MEDIUM"
        if soil_moisture is not None and soil_moisture < 30:
            pump = "SHORT IRRIGATION (soil is dry)"
        else:
            pump = "OFF"
        alarm = "OFF"
    else:
        fan = "LOW"
        pump = "OFF"
        alarm = "OFF"

    return {"fan": fan, "pump": pump, "alarm": alarm}


if _name_ == "_main_":
    print(decide_actuators(25, soil_moisture=15))
    print(decide_actuators(50, soil_moisture=20))
    print(decide_actuators(50, soil_moisture=60))
    print(decide_actuators(85, soil_moisture=70))	