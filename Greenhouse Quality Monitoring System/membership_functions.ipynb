"""
membership_functions.py
------------------------
Triangular membership functions (TMF) for the Greenhouse Quality
Monitoring System, using the EXACT (a, b, c) parameters from the
project report. Do not change these values.

A triangular membership function is defined by three points (a, b, c):
    - a: point where membership starts rising from 0
    - b: point where membership = 1 (the peak)
    - c: point where membership falls back to 0

    mu(x) = 0                      , x <= a
          = (x - a) / (b - a)      , a < x <= b
          = (c - x) / (c - b)      , b < x < c
          = 0                      , x >= c
"""


def triangular_mf(x, a, b, c):
    """Compute the triangular membership value of x for MF (a, b, c)."""
    if b == a:
        left = 1.0 if x <= a else 0.0
    else:
        left = (x - a) / (b - a)

    if c == b:
        right = 1.0 if x >= c else 0.0
    else:
        right = (c - x) / (c - b)

    return max(min(left, right), 0.0)


# ---------------------------------------------------------------
# EXACT membership function parameters from the report
# ---------------------------------------------------------------

TEMPERATURE_MFS = {
    "Low":    (0, 10, 25),
    "Normal": (15, 25, 35),
    "High":   (25, 40, 50),
}

HUMIDITY_MFS = {
    "Dry":     (0, 20, 45),
    "Optimal": (30, 50, 70),
    "Humid":   (55, 80, 100),
}

SOIL_MOISTURE_MFS = {
    "Dry":      (0, 20, 40),
    "Moderate": (30, 50, 70),
    "Wet":      (60, 80, 100),
}

GQI_MFS = {
    "Poor":      (0, 20, 40),
    "Fair":      (30, 50, 70),
    "Excellent": (60, 80, 100),
}

# Representative crisp output values used for weighted-average
# defuzzification (Section 5 of the report).
GQI_REPRESENTATIVE_VALUES = {
    "Poor": 20,
    "Fair": 50,
    "Excellent": 80,
}

# Universes of discourse
TEMPERATURE_RANGE = (0, 50)
HUMIDITY_RANGE = (0, 100)
SOIL_MOISTURE_RANGE = (0, 100)
GQI_RANGE = (0, 100)


def fuzzify(value, mf_dict):
    """
    Given a crisp value and a dictionary of {label: (a, b, c)} MFs,
    return a dictionary of {label: membership_value}.
    """
    return {label: triangular_mf(value, *params) for label, params in mf_dict.items()}


def fuzzify_temperature(value):
    return fuzzify(value, TEMPERATURE_MFS)


def fuzzify_humidity(value):
    return fuzzify(value, HUMIDITY_MFS)


def fuzzify_soil_moisture(value):
    return fuzzify(value, SOIL_MOISTURE_MFS)